{
  "name": "unsequel",
  "version": "0.4.0",
  "description": "UNSeQueL query language compiler: write SQL-like queries in execution order and compile composable stages to DuckDB SQL.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absterjr/UNSeQueL.git",
    "directory": "compiler"
  },
  "homepage": "https://absterjr.github.io/UNSeQueL/",
  "keywords": [
    "query-language",
    "unsequel",
    "sql",
    "from-first",
    "execution-order",
    "sql-pipeline",
    "duckdb",
    "pipeline",
    "compiler",
    "data"
  ],
  "type": "module",
  "bin": {
    "unsequel": "./dist/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fmt:check": "node scripts/check-formatter.mjs",
    "editors:check": "node scripts/check-editors.mjs && node --check editors/vscode/extension.js",
    "smoke": "node dist/main.js run examples/real/r01_top_products.unsequel --format json && node dist/main.js run examples/real/r03_repeat_customers.unsequel --format csv && node dist/main.js run examples/real/r04_monthly_revenue.unsequel --format csv && node dist/main.js run examples/real/r05_share_of_total.unsequel --format json",
    "build:exe": "node scripts/build-sea.mjs",
    "build:run-exe": "node scripts/build-sea.mjs --with-duckdb",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "optionalDependencies": {
    "@duckdb/node-api": "^1.5.6-r.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  }
}
