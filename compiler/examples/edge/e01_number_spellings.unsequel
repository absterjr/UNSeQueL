# source edge: edge.csv
# Number spellings both tracks must agree on: DECIMAL scale, HUGEINT beyond
# 2^53 (plain-digit literals) vs DOUBLE (exponent literals), -0.0, boolean,
# and per-column JSON typing (mixed holds a safe and an unsafe integer).
from edge
sort n
select dec = CAST(n AS DECIMAL(10,2)), half = n / 4, tiny = n * 1e-7, sci = n * 1e21, wideint = n * 100000000000000000000, negzero = CAST(-0.0 AS DOUBLE), hugebig = CAST('9007199254740993' AS HUGEINT), wide = CAST('1234567890123456789012' AS DECIMAL(25,0)), flag = TRUE, mixed = CASE WHEN n = 4 THEN 10 ELSE 9007199254740993 END
