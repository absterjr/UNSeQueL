{
  "name": "unsequel-vscode",
  "displayName": "UNSeQueL",
  "description": "Language support for .unsequel query files: diagnostics, completion, hover (generated SQL), formatting, syntax highlighting, and run commands, powered by the unsequel CLI.",
  "version": "0.3.0",
  "publisher": "unsequel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/absterjr/UNSeQueL.git",
    "directory": "compiler/editors/vscode"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:unsequel",
    "onCommand:unsequel.runSelection",
    "onCommand:unsequel.runFile",
    "onCommand:unsequel.openRepl"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "unsequel",
        "aliases": [
          "UNSeQueL",
          "unsequel"
        ],
        "extensions": [
          ".unsequel"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "unsequel",
        "scopeName": "source.unsequel",
        "path": "./syntaxes/unsequel.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "unsequel.runSelection",
        "title": "UNSeQueL: Run Selection",
        "category": "UNSeQueL"
      },
      {
        "command": "unsequel.runFile",
        "title": "UNSeQueL: Run File",
        "category": "UNSeQueL"
      },
      {
        "command": "unsequel.openRepl",
        "title": "UNSeQueL: Open REPL",
        "category": "UNSeQueL"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "unsequel.runSelection",
          "when": "editorLangId == unsequel",
          "group": "navigation@1"
        },
        {
          "command": "unsequel.runFile",
          "when": "editorLangId == unsequel",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "UNSeQueL",
      "properties": {
        "unsequel.executable": {
          "type": "string",
          "default": "unsequel",
          "description": "The UNSeQueL executable to run (also used for `unsequel lsp`). Use an absolute path if it is not on PATH."
        },
        "unsequel.schemaPath": {
          "type": "string",
          "default": "",
          "description": "Schema JSON used for diagnostics, completion, and hover when a query has no '# schema:' directive. Leave empty to rely on directives."
        }
      }
    }
  }
}
