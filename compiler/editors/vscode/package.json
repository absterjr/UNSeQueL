{
  "name": "unsequel-vscode",
  "displayName": "UNSeQueL",
  "description": "UNSeQueL syntax highlighting and run commands for .unsequel query files, powered by DuckDB.",
  "version": "0.1.0",
  "publisher": "unsequel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/absterjr/UNSeQueL.git",
    "directory": "compiler/editors/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:unsequel",
    "onCommand:unsequel.runSelection",
    "onCommand:unsequel.runFile",
    "onCommand:unsequel.openRepl"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "unsequel",
        "aliases": [
          "UNSeQueL",
          "unsequel"
        ],
        "extensions": [
          ".unsequel"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "unsequel",
        "scopeName": "source.unsequel",
        "path": "./syntaxes/unsequel.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "unsequel.runSelection",
        "title": "UNSeQueL: Run Selection",
        "category": "UNSeQueL"
      },
      {
        "command": "unsequel.runFile",
        "title": "UNSeQueL: Run File",
        "category": "UNSeQueL"
      },
      {
        "command": "unsequel.openRepl",
        "title": "UNSeQueL: Open REPL",
        "category": "UNSeQueL"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "unsequel.runSelection",
          "when": "editorLangId == unsequel",
          "group": "navigation@1"
        },
        {
          "command": "unsequel.runFile",
          "when": "editorLangId == unsequel",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "UNSeQueL",
      "properties": {
        "unsequel.executable": {
          "type": "string",
          "default": "unsequel",
          "description": "The UNSeQueL executable to run. Use an absolute path if it is not on PATH."
        }
      }
    }
  }
}
