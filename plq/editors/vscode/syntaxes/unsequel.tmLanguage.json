{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "UNSeQueL",
  "scopeName": "source.unsequel",
  "patterns": [
    { "include": "#directives" },
    { "include": "#comments" },
    { "include": "#quoted-identifiers" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#numbers" }
  ],
  "repository": {
    "directives": {
      "patterns": [
        {
          "match": "^\\s*#\\s*(source\\s+[A-Za-z_][A-Za-z0-9_]*|schema)\\s*:(.*)$",
          "captures": {
            "1": { "name": "keyword.control.directive.unsequel" },
            "2": { "name": "string.unquoted.path.unsequel" }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "match": "#.*$",
          "name": "comment.line.number-sign.unsequel"
        },
        {
          "match": "--.*$",
          "name": "comment.line.double-dash.unsequel"
        }
      ]
    },
    "quoted-identifiers": {
      "patterns": [
        {
          "match": "`(?:``|[^`])+`",
          "name": "variable.other.quoted.unsequel"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.unsequel",
          "patterns": [
            { "match": "\\\\.", "name": "constant.character.escape.unsequel" }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(?:from|join|left|right|full|cross|filter|derive|group|by|aggregate|having|window|select|sort|skip|take|distinct|sql|union|except|intersect|each)\\b",
          "name": "keyword.control.stage.unsequel"
        },
        {
          "match": "\\b(?:on|as|over|partition|order|asc|desc|and|or|not|in|like|between|is|null|case|when|then|else|end|cast|true|false)\\b",
          "name": "keyword.operator.word.unsequel"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "(?i)\\b(?:count|sum|avg|min|max|coalesce|nullif|lower|upper|abs|round|length|trim|concat|strftime|date_trunc|row_number|rank|dense_rank|lag|lead)\\b(?=\\s*\\()",
          "name": "support.function.unsequel"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(?:<>|!=|<=|>=|=|<|>|\\|)",
          "name": "keyword.operator.comparison.unsequel"
        },
        {
          "match": "(?:\\*|/|%|\\+|-)",
          "name": "keyword.operator.arithmetic.unsequel"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b\\d+(?:\\.\\d+)?\\b",
          "name": "constant.numeric.unsequel"
        }
      ]
    }
  }
}
