{
  "name": "plq",
  "version": "0.1.0",
  "description": "PLQ compiler: pipeline query language, compiles to DuckDB SQL one CTE per pipeline unit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absterjr/UNSeQueL.git",
    "directory": "plq"
  },
  "keywords": [
    "query-language",
    "sql",
    "duckdb",
    "pipeline",
    "compiler",
    "data"
  ],
  "type": "module",
  "bin": {
    "plq": "./dist/main.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.6-r.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
