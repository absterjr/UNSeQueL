{
  "name": "unsequel-plq",
  "version": "0.2.0",
  "description": "UNSeQueL PLQ compiler: write SQL-like queries in execution order and compile composable stages to DuckDB SQL.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absterjr/UNSeQueL.git",
    "directory": "plq"
  },
  "homepage": "https://absterjr.github.io/UNSeQueL/",
  "keywords": [
    "query-language",
    "unsequel",
    "sql",
    "from-first",
    "execution-order",
    "sql-pipeline",
    "duckdb",
    "pipeline",
    "compiler",
    "data"
  ],
  "type": "module",
  "bin": {
    "plq": "./dist/main.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "examples",
    "editors"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fmt:check": "node scripts/check-formatter.mjs",
    "editors:check": "node scripts/check-editors.mjs && node --check editors/vscode/extension.js",
    "smoke": "node dist/main.js run examples/real/r01_top_products.plq --format json && node dist/main.js run examples/real/r03_repeat_customers.plq --format csv && node dist/main.js run examples/real/r04_monthly_revenue.plq --format csv && node dist/main.js run examples/real/r05_share_of_total.plq --format json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.6-r.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  }
}
